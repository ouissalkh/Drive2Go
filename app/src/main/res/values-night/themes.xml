<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Thème principal night -->
    <style name="Theme.Drive_2_Go" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Couleurs primaires -->
        <item name="colorPrimary">@color/purple_200</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/black</item>

        <!-- Couleurs secondaires -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Surface & Background (mode sombre) -->
        <item name="colorSurface">@color/black</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="android:colorBackground">@color/black</item>
        <item name="colorOnBackground">@color/white</item>

        <!-- Erreur -->
        <item name="colorError">#FF4444</item>
        <item name="colorOnError">@color/white</item>

        <!-- Buttons Material -->
        <item name="materialButtonStyle">@style/Widget.MaterialComponents.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.MaterialComponents.Button.OutlinedButton</item>

        <!-- Indispensable pour TextInputLayout -->
        <item name="materialThemeOverlay">@style/ThemeOverlay.MaterialComponents</item>

        <!-- Status & Navigation bar -->
        <item name="android:statusBarColor">@color/purple_700</item>
        <item name="android:navigationBarColor">@color/black</item>

        <!-- Couleurs des contrôles -->
        <item name="colorControlActivated">@color/purple_200</item>
        <item name="colorControlHighlight">@color/teal_700</item>
        <item name="colorControlNormal">@color/gris</item>

    </style>

</resources>
