<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Thème principal clair -->
    <style name="Theme.Drive_2_Go" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Couleurs primaires -->
        <item name="colorPrimary">@color/emerald_900</item>
        <item name="colorPrimaryVariant">@color/black</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Couleurs secondaires -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Surface & Background -->
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="android:colorBackground">@color/white</item>
        <item name="colorOnBackground">@color/black</item>

        <!-- Erreur -->
        <item name="colorError">#C31616</item>
        <item name="colorOnError">@color/white</item>

        <!-- Buttons Material -->
        <item name="materialButtonStyle">@style/Widget.MaterialComponents.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.MaterialComponents.Button.OutlinedButton</item>

        <!-- Nécessaire pour TextInputLayout et TextAppearance -->
        <item name="materialThemeOverlay">@style/ThemeOverlay.MaterialComponents</item>

        <!-- Status & Navigation bar -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:navigationBarColor">@color/white</item>

        <!-- Couleurs des contrôles -->
        <item name="colorControlActivated">@color/grey</item>
        <item name="colorControlHighlight">@color/purple_200</item>
        <item name="colorControlNormal">@color/gray_500</item>

    </style>

</resources>
