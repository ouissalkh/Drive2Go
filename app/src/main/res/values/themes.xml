<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- THÈME PRINCIPAL -->
    <style name="Theme.Drive_2_Go" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- ============================================== -->
        <!-- 1. CONFIGURATION DES COULEURS (Base du fichier 2) -->
        <!-- ============================================== -->
        
        <!-- Couleurs primaires -->
        <!-- Assurez-vous que @color/emerald_900 existe dans colors.xml -->
        <item name="colorPrimary">@color/emerald_900</item> 
        <item name="colorPrimaryVariant">@color/black</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Couleurs secondaires -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Surface & Fond -->
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="android:colorBackground">@color/white</item>
        <item name="colorOnBackground">@color/black</item>

        <!-- Erreur -->
        <item name="colorError">#C31616</item>
        <item name="colorOnError">@color/white</item>

        <!-- ============================================== -->
        <!-- 2. BARRE DE STATUT (Haut de l'écran - Fichier 1) -->
        <!-- ============================================== -->
        
        <!-- Couleur spécifique vert très foncé -->
        <item name="android:statusBarColor">#0D2301</item>
        <!-- false = Icones BLANCHES (car le fond est foncé) -->
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- Barre de navigation (Bas de l'écran) -->
        <item name="android:navigationBarColor">@color/white</item>


        <!-- ============================================== -->
        <!-- 3. COMPOSANTS ET STYLES GLOBAUX -->
        <!-- ============================================== -->
        
        <!-- Boutons Material -->
        <item name="materialButtonStyle">@style/Widget.MaterialComponents.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.MaterialComponents.Button.OutlinedButton</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.MaterialComponents</item>

        <!-- Couleurs des contrôles (checkboxes, etc.) -->
        <item name="colorControlActivated">@color/grey</item>
        <item name="colorControlHighlight">@color/purple_200</item>
        <item name="colorControlNormal">@color/gray_500</item>
    </style>


    <!-- ============================================== -->
    <!-- STYLES SUPPLÉMENTAIRES (Extraits et réparés) -->
    <!-- ============================================== -->

    <!-- Style pour vos champs de texte (TextInputLayout) en blanc -->
    <!-- À utiliser dans vos XML avec : style="@style/WhiteOutlineBox" -->
    <style name="WhiteOutlineBox" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/white</item>
        <item name="hintTextColor">@color/white</item>
        <item name="android:textColorHint">@color/white</item>
    </style>

    <!-- Style pour les arrondis -->
    <style name="ShapeAppearanceOverlay.App.CornerSize50Percent" parent="">
        <item name="cornerSize">50%</item>
    </style>

</resources>
