<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="8dp"
    android:layout_marginHorizontal="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    android:background="#FFFFFF">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp">

        <!-- FOND DU PRIX (Coin haut droit) -->
        <View
            android:id="@+id/view_price_bg"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="-10dp"
            android:layout_marginEnd="-10dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.35" />

        <!-- TEXTE DU PRIX -->
        <TextView
            android:id="@+id/tv_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_prix"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:gravity="center"
            android:text="450 Dh"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:elevation="2dp"
            android:rotation="0"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="0dp"/>

        <!-- INDICATEUR DE DISPONIBILITÉ (Barre de texte demandée) -->
        <TextView
            android:id="@+id/tv_availability"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Disponible"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:background="#4CAF50"
            android:layout_marginStart="0dp"
            android:layout_marginTop="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- INFOS VÉHICULE (Nom + Plaque) -->
        <LinearLayout
            android:id="@+id/layout_car_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="28dp"
            app:layout_constraintEnd_toStartOf="@id/tv_price"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tv_car_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Renault Captur"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tv_license_plate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GH-391-AD"
                android:textColor="#757575"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- DÉTAILS VERTICAUX (Carburant, Km) À DROITE -->
        <LinearLayout
            android:id="@+id/layout_details_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            android:gravity="end"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_price">

            <!-- Carburant -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_fuel_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Diesel"
                    android:textColor="#000000"
                    android:textSize="13sp"
                    android:layout_marginEnd="6dp"/>

                <ImageView
                    android:id="@+id/img_fuel_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_fuel"
                    app:tint="#000000"/>
            </LinearLayout>

            <!-- Kilométrage -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_max_km"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="800 km"
                    android:textColor="#000000"
                    android:textSize="13sp"
                    android:layout_marginEnd="6dp"/>

                <ImageView
                    android:id="@+id/img_mileage_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_mileage"
                    app:tint="#000000"/>
            </LinearLayout>
        </LinearLayout>

        <!-- IMAGE DE LA VOITURE -->
        <ImageView
            android:id="@+id/img_car"
            android:layout_width="0dp"
            android:layout_height="130dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/car"
            app:layout_constraintEnd_toStartOf="@+id/layout_details_vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_car_info" />


        <!-- BARRE D'ICÔNES EN BAS (Bagages, AC, Check, Boite, Portes, Places) -->
        <LinearLayout
            android:id="@+id/layout_icons_bottom"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:gravity="center_vertical"
            app:layout_constraintEnd_toStartOf="@+id/layout_admin_buttons"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/img_car">

            <!-- Bagages -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginEnd="8dp">
                <ImageView
                    android:id="@+id/img_baggage_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_baggage"
                    app:tint="#000000"/>
                <TextView
                    android:id="@+id/tv_baggage_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2"
                    android:textSize="12sp"
                    android:layout_marginStart="2dp"/>
            </LinearLayout>

            <!-- AC (Conditionnel) -->
            <ImageView
                android:id="@+id/img_ac_status"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_snowflake"
                app:tint="#000000"/>

            <!-- Check (Conditionnel) -->
            <ImageView
                android:id="@+id/img_check_status"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_check"
                app:tint="#4CAF50"/>

            <!-- Boite de vitesse -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginEnd="8dp">
                <ImageView
                    android:id="@+id/img_gear_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_gears"
                    app:tint="#000000"/>
                <TextView
                    android:id="@+id/tv_gear_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="M"
                    android:textSize="12sp"
                    android:layout_marginStart="2dp"/>
            </LinearLayout>

            <!-- Portes -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginEnd="8dp">
                <ImageView
                    android:id="@+id/img_door_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_car_door"
                    app:tint="#000000"/>
                <TextView
                    android:id="@+id/tv_door_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5"
                    android:textSize="12sp"
                    android:layout_marginStart="2dp"/>
            </LinearLayout>

            <!-- Passagers -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">
                <ImageView
                    android:id="@+id/img_people_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_people"
                    app:tint="#000000"/>
                <TextView
                    android:id="@+id/tv_people_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5"
                    android:textSize="12sp"
                    android:layout_marginStart="2dp"/>
            </LinearLayout>

        </LinearLayout>

        <!-- BOUTONS ADMIN (Modifier / Supprimer) -->
        <LinearLayout
            android:id="@+id/layout_admin_buttons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@id/layout_icons_bottom"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/layout_icons_bottom">

            <ImageView
                android:id="@+id/btnEdit"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_edit"
                android:padding="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#000000"
                android:layout_marginEnd="8dp"/>

            <ImageView
                android:id="@+id/btnDelete"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_delete"
                android:padding="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#000000"/>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>