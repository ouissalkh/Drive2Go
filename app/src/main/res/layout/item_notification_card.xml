<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- IMAGE PROFIL -->
        <ImageView
            android:id="@+id/img_profile"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:contentDescription="Avatar"
            android:src="@drawable/ic_default_avatar"
            android:scaleType="centerCrop"
            android:background="@drawable/circle_background_gray"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <!-- CONTENEUR DES BOUTONS (Accept/Refuse) -->
        <LinearLayout
            android:id="@+id/action_buttons_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0.5">

            <ImageButton
                android:id="@+id/btn_cancel"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="Refuser"
                android:src="@drawable/ic_cancel_red"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="fitCenter"
                android:padding="5dp"/>

            <ImageButton
                android:id="@+id/btn_accept"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:contentDescription="Accepter"
                android:src="@drawable/ic_check_green"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="fitCenter"
                android:padding="5dp"/>
        </LinearLayout>

        <!-- TEXTE : NOM UTILISATEUR -->
        <TextView
            android:id="@+id/tv_user_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:text="Nom Utilisateur"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000"
            app:layout_constraintStart_toEndOf="@+id/img_profile"
            app:layout_constraintTop_toTopOf="@+id/img_profile"
            app:layout_constraintEnd_toStartOf="@+id/action_buttons_layout"/>

        <!-- TEXTE : "A DEMANDÉ..." -->
        <TextView
            android:id="@+id/tv_action_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="a demandé de louer"
            android:textSize="12sp"
            android:textColor="#757575"
            app:layout_constraintStart_toStartOf="@+id/tv_user_name"
            app:layout_constraintTop_toBottomOf="@+id/tv_user_name"
            app:layout_constraintEnd_toStartOf="@+id/action_buttons_layout"/>

        <!-- TEXTE : VOITURE -->
        <TextView
            android:id="@+id/tv_car_model"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Modèle Voiture"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1976D2"
            android:layout_marginTop="2dp"
            app:layout_constraintStart_toStartOf="@+id/tv_user_name"
            app:layout_constraintTop_toBottomOf="@+id/tv_action_text"
            app:layout_constraintEnd_toStartOf="@+id/action_buttons_layout"/>

        <!-- TEXTE : DATES -->
        <TextView
            android:id="@+id/tv_duration"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Dates de location"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            android:textColor="#424242"
            app:layout_constraintStart_toStartOf="@+id/tv_user_name"
            app:layout_constraintTop_toBottomOf="@+id/tv_car_model"
            app:layout_constraintEnd_toStartOf="@+id/action_buttons_layout"/>

        <!-- TEXTE : PRIX -->
        <TextView
            android:id="@+id/tv_request_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Prix Total"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#00796B"
            android:layout_marginTop="2dp"
            app:layout_constraintStart_toStartOf="@+id/tv_user_name"
            app:layout_constraintTop_toBottomOf="@+id/tv_duration"
            app:layout_constraintEnd_toStartOf="@+id/action_buttons_layout"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>