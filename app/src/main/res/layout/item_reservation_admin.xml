<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="10dp">

        <!-- HEADER VERT -->
        <View
            android:id="@+id/headerBg"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:background="@drawable/bg_header_rounded"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvResNum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:text="Réservation #JT1FYIRK"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Fatima Zahra Moumni"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvResNum" />

        <!-- Badge Confirmée -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_rounded_price"
            android:backgroundTint="#33FFFFFF"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="En attente de validation"
            android:textColor="@color/white"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <!-- SECTION VÉHICULE -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/containerVehicle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_rounded_gray"
            android:padding="5dp"
            app:layout_constraintTop_toBottomOf="@id/headerBg">

            <ImageButton
                android:id="@+id/iconVehicle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="Vehicle icon"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_iconcar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <TextView
                android:id="@+id/lblVehicle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Véhicule"
                android:textColor="@color/text_gray"
                android:textSize="11sp"
                app:layout_constraintStart_toEndOf="@id/iconVehicle"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvVehicleName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Toyota Corolla"
                android:textColor="@color/text_dark"
                android:textSize="16sp"
                app:layout_constraintStart_toEndOf="@id/iconVehicle"
                app:layout_constraintTop_toBottomOf="@id/lblVehicle" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- SECTION PÉRIODE -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/containerPeriod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_rounded_gray"
            android:backgroundTint="@color/blue_bg"
            android:padding="5dp"
            app:layout_constraintTop_toBottomOf="@id/containerVehicle">

            <ImageButton
                android:id="@+id/iconPeriod"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="Calendar icon"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_calendar_noir"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <TextView
                android:id="@+id/lblPeriod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Période"
                android:textColor="@color/text_gray"
                android:textSize="11sp"
                app:layout_constraintStart_toEndOf="@id/iconPeriod"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvPeriodDates"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="13/12/2025\nau 20/12/2025"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                app:layout_constraintStart_toEndOf="@id/iconPeriod"
                app:layout_constraintTop_toBottomOf="@id/lblPeriod" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- CONTACT INFO -->
        <TextView
            android:id="@+id/tvEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:drawablePadding="8dp"
            android:text=""
            android:textColor="@color/text_dark"
            app:drawableStartCompat="@drawable/ic_email_noir"
            app:drawableTint="@color/text_gray"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/containerPeriod" />


        <TextView
            android:id="@+id/tvPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="16dp"
            android:drawablePadding="8dp"
            android:text=""
            android:textColor="@color/text_dark"
            app:drawableStartCompat="@drawable/ic_phone_noir"
            app:drawableTint="@color/text_gray"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvEmail" />

        <!-- PRIX TOTAL -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/containerPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_rounded_price"
            android:padding="5dp"
            app:layout_constraintTop_toBottomOf="@id/tvPhone">

            <TextView
                android:id="@+id/tvCurrency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$"
                android:textSize="24sp"
                android:textColor="@color/teal_primary"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Prix total"
                android:textColor="@color/text_gray"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/tvCurrency"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvTotalPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2800,00 DH"
                android:textColor="@color/teal_text"
                android:textSize="24sp"
                android:textStyle="normal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- BOUTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetails"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:paddingVertical="5dp"
            android:text="Voir les détails"
            android:textAllCaps="false"
            android:textColor="@color/text_dark"
            app:icon="@android:drawable/ic_menu_view"
            app:iconGravity="textStart"
            app:iconTint="@color/text_dark"
            app:strokeColor="#E0E0E0"
            app:cornerRadius="8dp"
            app:layout_constraintTop_toBottomOf="@id/containerPrice" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>